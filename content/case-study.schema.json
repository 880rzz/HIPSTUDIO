{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.hipstudio.hu/schemas/case-study.schema.json",
  "title": "HIPStudio evidence-gated case study",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "slug", "title", "status", "challenge", "scope", "evidence"],
  "properties": {
    "key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "slug": {"$ref": "#/$defs/localized"},
    "title": {"$ref": "#/$defs/localized"},
    "status": {"enum": ["draft", "approved"]},
    "client": {"type": ["string", "null"]},
    "challenge": {"$ref": "#/$defs/localized"},
    "scope": {"$ref": "#/$defs/localized"},
    "method": {"$ref": "#/$defs/localized"},
    "outcome": {"$ref": "#/$defs/localized"},
    "services": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "media": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hu", "en", "de"],
      "properties": {"hu": {"type": "string"}, "en": {"type": "string"}, "de": {"type": "string"}}
    }
  }
}
