# INACTIVE TEMPLATE. Copy into .github/workflows only AFTER publication approval.
name: Publish approved HIPStudio
on:
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: false
jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Build approved production
        env:
          BUILD_MODE: production
          SITE_URL: https://880rzz.github.io/HIPSTUDIO
        run: python3 tools/build.py
      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist
      - name: Publish
        id: deployment
        uses: actions/deploy-pages@v4
